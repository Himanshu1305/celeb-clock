// Generates src/data/saturnIngresses.json — every sidereal (Lahiri) Saturn sign ingress
// from 1 Jan 1940 to 1 Jan 2071, INCLUDING retrograde back-and-forth crossings, computed
// with our own chart engine (getSaturnSignIndex, src/lib/vedic/engine/vedicEngine.ts).
// Used by the per-rashi Sade Sati pages (/sade-sati/:rashi, /hi/sade-sati/:rashi), which
// show the 1950–2060 periods; the extra decade on each side makes the first/last cycles
// complete. Checked against Swiss Ephemeris in
// src/lib/vedic/__tests__/sadeSatiRashi.test.ts (max difference reported there).
// Re-run: npx tsx scripts/gen-saturn-ingresses.mts
import { writeFileSync } from 'fs';
import { resolve, dirname } from 'path';
import { fileURLToPath } from 'url';
import { saturnIngressesBetween } from '../src/lib/vedic/saturnIngressScan';

const __dirname = dirname(fileURLToPath(import.meta.url));
const from = Date.UTC(1940, 0, 1), to = Date.UTC(2071, 0, 1);
const { initialSign, ingresses } = saturnIngressesBetween(from, to);
const out = {
  note: 'Generated by scripts/gen-saturn-ingresses.mts from the BornClock engine (Lahiri). Do not edit by hand.',
  range: ['1940-01-01', '2071-01-01'],
  initialSign,
  ingresses,
};
writeFileSync(resolve(__dirname, '../src/data/saturnIngresses.json'), JSON.stringify(out, null, 0).replace(/\},\{/g, '},\n{') + '\n');
console.log(`wrote ${ingresses.length} ingresses`);
