/**
 * B21 (SEO): generate functions/knownRoutes.ts — every route pattern declared in src/App.tsx, as
 * regular expressions the Worker can test. A path that matches none of them (and is not a regional
 * language page, which the Worker validates separately) is served as a real 404, not as a soft-200
 * copy of the homepage. Run:  npx tsx scripts/gen-known-routes.mts
 * scripts/__tests__/knownRoutes.test.ts fails if this file is out of date with App.tsx.
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { MONTH_HUB_DATA } from '../src/data/monthHubData';
import { FITNESS_PAGES } from '../src/data/fitnessPages';

export function knownRoutePatterns(appSource: string): string[] {
  const paths = [...appSource.matchAll(/<Route\s+path="([^"]+)"/g)].map(m => m[1]).filter(p => p !== '*');
  // Routes App.tsx builds from data with template literals (path={`/born-in-${m.slug}`} …).
  if (appSource.includes('path={`/born-in-${m.slug}`}')) paths.push(...MONTH_HUB_DATA.map(m => `/born-in-${m.slug}`));
  if (appSource.includes('path={`/${p.slug}`}')) paths.push(...FITNESS_PAGES.map(p => `/${p.slug}`));
  const toRe = (p: string) => '^' + p.replace(/\/$/, '').split('/').map(seg =>
    seg === '*' ? '.*' : seg.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/:[A-Za-z0-9_]+/g, '[^/]+'),
  ).join('/') + '/?$';
  return [...new Set(paths.map(toRe))].sort();
}

export function renderKnownRoutes(patterns: string[]): string {
  return `/* GENERATED by scripts/gen-known-routes.mts from src/App.tsx — do not edit by hand. */
export const KNOWN_ROUTE_PATTERNS: string[] = ${JSON.stringify(patterns, null, 1)};
const RES = KNOWN_ROUTE_PATTERNS.map(p => new RegExp(p));
export function isKnownRoute(pathname: string): boolean {
  return pathname === '/' || RES.some(r => r.test(pathname));
}
`;
}

if (process.argv[1]?.endsWith('gen-known-routes.mts')) {
  const out = renderKnownRoutes(knownRoutePatterns(readFileSync('src/App.tsx', 'utf8')));
  writeFileSync('functions/knownRoutes.ts', out);
  console.log('[known-routes] functions/knownRoutes.ts written');
}
