{
  // Batch 10: this used to be a "solution" file with `"files": []` + references, so
  // `npx tsc --noEmit -p .` type-checked NOTHING. It now extends the app config and
  // includes the client (src), the API handlers (api) and the Worker (functions), so the
  // standard `npx tsc --noEmit -p .` (and CI's "Type check" step) is a real check.
  // vite.config.ts is checked separately with tsconfig.node.json (see `npm run typecheck`).
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "api",
    "functions"
  ]
}
